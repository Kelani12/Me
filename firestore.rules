rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserData() {
      return request.resource.data.keys().hasAll(['name', 'createdAt']) &&
             request.resource.data.name is string &&
             request.resource.data.createdAt is timestamp;
    }

    // Public educational content
    match /resources/{resourceId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // Public support content or emergency contact info
    match /supportInfo/{docId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // Each user owns their own profile
    match /users/{userId} {
      allow create: if isOwner(userId) && isValidUserData();
      allow read, update, delete: if isOwner(userId);
    }

    // Personal period-tracking history
    match /cycles/{entryId} {
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.createdAt is timestamp;

      allow read, update, delete: if isSignedIn() &&
        resource.data.userId == request.auth.uid;
    }

    // Personal chat session records
    match /chatSessions/{sessionId} {
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.createdAt is timestamp;

      allow read, update, delete: if isSignedIn() &&
        resource.data.userId == request.auth.uid;
    }

    // Messages inside a chat session
    match /chatSessions/{sessionId}/messages/{messageId} {
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;

      allow read, update, delete: if isSignedIn() &&
        resource.data.userId == request.auth.uid;
    }

    // Saved notes or personal reminders
    match /notes/{noteId} {
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;

      allow read, update, delete: if isSignedIn() &&
        resource.data.userId == request.auth.uid;
    }

    // Any other documents are blocked
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
